OPENAI_API_KEY=sk-...
OPENAI_MODEL=gpt-4o-mini

# Direct database connection (MariaDB Cloud hosts currently use *.skysql.com)
DB_HOST=your-mariadb-host
DB_PORT=3306
DB_USER=readonly_user
DB_PASSWORD=readonly_password
DB_DATABASE=your_db_name

# Optional MariaDB Cloud API integration
MARIADB_CLOUD_API_KEY=skysql....
MARIADB_CLOUD_LOG_API_URL=https://api.skysql.com/observability/v2/logs
MARIADB_CLOUD_SERVICE_ID=dbpgp40039323
